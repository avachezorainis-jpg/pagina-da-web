<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Habilidades Web e Pensamento Crítico</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <header>
        <nav class="navbar">
            <h1>Web & Impacto Social</h1>

            <button id="menuBtn" aria-label="Abrir menu">
                ☰
            </button>

            <ul id="menu">
                <li><a href="#inicio">Início</a></li>
                <li><a href="#aprendizado">O que vamos aprender?</a></li>
                <li><a href="#projeto">Projeto</a></li>
                <li><a href="#quiz">Quiz</a></li>
            </ul>
        </nav>
    </header>

    <main>

        <section id="inicio" class="hero">
            <div>
                <h2>Criação Web e Pensamento Crítico</h2>

                <p>
                    Aprenda a construir projetos digitais interativos,
                    acessíveis e colaborativos, usando tecnologia para
                    solucionar problemas reais.
                </p>

                <a href="#aprendizado" class="botao">
                    Começar
                </a>
            </div>
        </section>

        <section id="aprendizado" class="section">
            <h2>O que vamos aprender?</h2>

            <div class="cards">

                <article class="card">
                    <span>💻</span>
                    <h3>Desenvolvimento Web</h3>
                    <p>
                        Estruturar páginas com HTML, estilizar com CSS
                        e criar layouts responsivos utilizando Flexbox.
                    </p>
                </article>

                <article class="card">
                    <span>⚡</span>
                    <h3>Interatividade com JavaScript</h3>
                    <p>
                        Manipular o DOM e desenvolver funcionalidades
                        dinâmicas para tornar as páginas mais interativas.
                    </p>
                </article>

                <article class="card">
                    <span>♿</span>
                    <h3>UX e Ética Digital</h3>
                    <p>
                        Aplicar princípios de acessibilidade, experiência
                        do usuário e produção responsável de conteúdo.
                    </p>
                </article>

                <article class="card">
                    <span>🤖</span>
                    <h3>IA e Colaboração</h3>
                    <p>
                        Planejar, prototipar e validar soluções para
                        problemas reais utilizando inteligência artificial
                        como ferramenta de apoio.
                    </p>
                </article>

            </div>
        </section>

        <section id="projeto" class="section projeto">
            <h2>Nosso projeto</h2>

            <p>
                O objetivo é criar uma solução digital que ajude a
                comunidade em algum problema real.
            </p>

            <div class="passos">

                <div>
                    <strong>1</strong>
                    <h3>Identificar</h3>
                    <p>Encontrar um problema que precisa de solução.</p>
                </div>

                <div>
                    <strong>2</strong>
                    <h3>Planejar</h3>
                    <p>Pensar em ideias e definir os objetivos.</p>
                </div>

                <div>
                    <strong>3</strong>
                    <h3>Prototipar</h3>
                    <p>Criar uma primeira versão da solução.</p>
                </div>

                <div>
                    <strong>4</strong>
                    <h3>Validar</h3>
                    <p>Testar, receber opiniões e melhorar o projeto.</p>
                </div>

            </div>
        </section>

        <section id="quiz" class="section quiz">
            <h2>Teste seus conhecimentos</h2>

            <p>
                Qual tecnologia é usada principalmente para adicionar
                interatividade às páginas web?
            </p>

            <div class="opcoes">
                <button class="opcao" data-correta="false">HTML</button>
                <button class="opcao" data-correta="false">CSS</button>
                <button class="opcao" data-correta="true">JavaScript</button>
                <button class="opcao" data-correta="false">Flexbox</button>
            </div>

            <p id="resultado"></p>
        </section>

    </main>

    <footer>
        <p>
            Projeto educacional — Criação Web, Pensamento Crítico e Impacto Social.
        </p>
    </footer>

    <script src="js/script.js"></script>

</body>
</html>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #222;
    background: #f5f7fb;
}

/* NAVBAR */

header {
    background: #151b2e;
    color: white;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar {
    max-width: 1100px;
    margin: auto;
    padding: 15px 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.navbar h1 {
    font-size: 20px;
}

.navbar ul {
    display: flex;
    list-style: none;
    gap: 25px;
}

.navbar a {
    color: white;
    text-decoration: none;
}

.navbar a:hover {
    text-decoration: underline;
}

#menuBtn {
    display: none;
    background: none;
    border: none;
    color: white;
    font-size: 25px;
    cursor: pointer;
}

/* HERO */

.hero {
    min-height: 80vh;
    padding: 80px 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    background: linear-gradient(
        135deg,
        #283593,
        #5c6bc0
    );

    color: white;
}

.hero div {
    max-width: 750px;
}

.hero h2 {
    font-size: 45px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 20px;
    margin-bottom: 30px;
}

.botao {
    display: inline-block;
    padding: 12px 25px;

    background: white;
    color: #283593;

    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
}

.botao:hover {
    transform: scale(1.05);
}

/* SEÇÕES */

.section {
    max-width: 1100px;
    margin: auto;
    padding: 70px 20px;
}

.section > h2 {
    text-align: center;
    margin-bottom: 40px;
    font-size: 32px;
}

/* CARDS */

.cards {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
}

.card {
    background: white;

    width: 250px;
    padding: 25px;

    border-radius: 12px;

    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);

    transition: transform 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}

.card span {
    font-size: 35px;
}

.card h3 {
    margin: 15px 0 10px;
}

/* PROJETO */

.projeto {
    text-align: center;
}

.passos {
    margin-top: 40px;

    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.passos div {
    background: white;
    width: 220px;
    padding: 25px;
    border-radius: 12px;
}

.passos strong {
    display: inline-flex;

    width: 45px;
    height: 45px;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #283593;
    color: white;

    font-size: 20px;
}

/* QUIZ */

.quiz {
    text-align: center;
}

.opcoes {
    margin-top: 25px;

    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
}

.opcao {
    padding: 12px 25px;

    border: 2px solid #283593;
    border-radius: 8px;

    background: white;
    color: #283593;

    cursor: pointer;
    font-size: 16px;
}

.opcao:hover {
    background: #283593;
    color: white;
}

#resultado {
    margin-top: 25px;
    font-weight: bold;
}

/* FOOTER */

footer {
    padding: 25px;
    text-align: center;

    background: #151b2e;
    color: white;
}

/* RESPONSIVIDADE */

@media (max-width: 700px) {

    #menuBtn {
        display: block;
    }

    .navbar ul {
        display: none;
        flex-direction: column;

        position: absolute;
        top: 60px;
        left: 0;

        width: 100%;

        background: #151b2e;

        padding: 20px;
        text-align: center;
    }

    .navbar ul.ativo {
        display: flex;
    }

    .hero h2 {
        font-size: 32px;
    }

    .hero p {
        font-size: 17px;
    }

    .card {
        width: 100%;
    }

    .passos div {
        width: 100%;
    }
// MENU MOBILE

const menuBtn = document.getElementById("menuBtn");
const menu = document.getElementById("menu");

menuBtn.addEventListener("click", function () {
    menu.classList.toggle("ativo");
});


// QUIZ

const opcoes = document.querySelectorAll(".opcao");
const resultado = document.getElementById("resultado");

opcoes.forEach(function (opcao) {

    opcao.addEventListener("click", function () {

        const correta = opcao.dataset.correta;

        if (correta === "true") {
            resultado.textContent = "Resposta correta! 🎉";
        } else {
            resultado.textContent = "Resposta incorreta. Tente novamente!";
        }

    });

});
